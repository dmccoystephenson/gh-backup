# GitHub Personal Access Token (optional but recommended for higher API rate limits)
# Get one from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Comma-separated list of GitHub users/organizations to backup
# Example: SCHEDULED_USERS=octocat,github,spring-projects
SCHEDULED_USERS=octocat

# Delay between scheduled backups, in milliseconds
# Leave empty to use the default of 86400000 (24 hours)
# Example: BACKUP_INTERVAL_MS=3600000 (1 hour)
BACKUP_INTERVAL_MS=

# Usage reporting: gh-backup sends a 'startup' event (program name and version)
# and a 'backup-completed' event (nothing else) to the maintainers' trace
# service. Nothing about the users or repositories being backed up is sent.
# Set to false to turn it off. See CONFIG.md.
USAGE_REPORTING_ENABLED=true
